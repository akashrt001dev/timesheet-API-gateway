# ========================================
# Security & Session Configuration
# ========================================
CSRF_COOKIE_ACCESSIBLE_FROM_JS=true
LOGIN_PATH=/
POST_LOGIN_REDIRECT_PATH=/home/
POST_LOGOUT_REDIRECT_PATH=/home
BACK_CHANNEL_LOGOUT_ENABLED=true
PERMIT_ALL_PATHS=/login/**,/oauth2/**,/,/login-options,/me

# ========================================
# Timeouts & Lifecycle Configuration
# ========================================
SHUTDOWN_TIMEOUT_SECONDS=30
CONNECTION_TIMEOUT_SECONDS=30
REQUEST_TIMEOUT_SECONDS=60

# ========================================
# Health Check Configuration
# ========================================
HEALTH_ENDPOINT_ENABLED=true
HEALTH_LIVENESS_ENABLED=true
HEALTH_READINESS_ENABLED=true
HEALTH_CHECK_INTERVAL_SECONDS=30
HEALTH_CHECK_TIMEOUT_SECONDS=10
HEALTH_CHECK_RETRIES=3

# ========================================
# Logging Configuration
# ========================================
LOG_LEVEL_ROOT=ERROR
LOG_LEVEL_SECURITY=DEBUG
LOG_FORMAT=json

# ========================================
# Eureka Service Discovery
# ========================================
EUREKA_ENABLED=true
EUREKA_URL=http://localhost:8761/eureka/
EUREKA_PREFER_IP_ADDRESS=true
EUREKA_HEARTBEAT_INTERVAL=30

# ========================================
# Gateway Discovery Configuration
# ========================================
GATEWAY_DISCOVERY_ENABLED=true
GATEWAY_LOWER_CASE_SERVICE_ID=true

# ========================================
# Feature Flags
# ========================================
FEATURE_EUREKA_DISCOVERY=true
FEATURE_TOKEN_RELAY=true
FEATURE_REQUEST_LOGGING=true
FEATURE_CORS_HEADERS=true
FEATURE_SESSION_MANAGEMENT=true

# ========================================
# Microservice Configuration
# Format: SERVICE_{SERVICE_NAME}_HOST and SERVICE_{SERVICE_NAME}_PORT
# Service names should be normalized (remove -service suffix, replace - with _)
# ========================================
KNOWN_SERVICES=user-management-service,contract-managment-service,entity-service,timesheet-management-service,notification-service

# User Management Service
SERVICE_USER_MANAGEMENT_HOST=localhost
SERVICE_USER_MANAGEMENT_PORT=8081

# Contract Management Service
SERVICE_CONTRACT_MANAGEMENT_HOST=localhost
SERVICE_CONTRACT_MANAGEMENT_PORT=8082

# Entity Service
SERVICE_ENTITY_HOST=localhost
SERVICE_ENTITY_PORT=8083

# Timesheet Management Service
SERVICE_TIMESHEET_MANAGEMENT_HOST=localhost
SERVICE_TIMESHEET_MANAGEMENT_PORT=8084

# Notification Service
SERVICE_NOTIFICATION_HOST=localhost
SERVICE_NOTIFICATION_PORT=8085
