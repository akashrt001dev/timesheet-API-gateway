# ========================================
# Gateway Service Configuration
# Python Migration from Java Spring Boot Gateway
# ========================================

# ========================================
# Server Configuration
# ========================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SCHEME=https
DEBUG=false
LOG_LEVEL=INFO
APP_PROFILE=qa

# ========================================
# Gateway Configuration
# ========================================
MASTER_ENTITY_NAME=timesmart-master
GATEWAY_BASE_URI=https://localhost:8000
REACT_APP_URI=https://app.timesmart.io
FLUTTER_APP_URI=https://app.timesmart.io
GREETINGS_API_URI=https://localhost:6443/greetings

# ========================================
# Keycloak Configuration
# ========================================
KEYCLOAK_SERVER_URL=https://idm.timesmart.io
KEYCLOAK_PORT=443

# Comma-separated list of realms to support
KEYCLOAK_REALMS=timesmart-master,apollo-demo,test,hopkins,cardinalhealth,mch,smmc-trial,pcc-trial,zukerberghospital,orthopedicsabbi,smmc-io-prod,tenet-io-prod

# ========================================
# OAuth2 Provider Configuration
# Format: OAUTH2_{REALM}_ISSUER (realm name with underscores)
# ========================================
OAUTH2_TIMESMART_MASTER_ISSUER=https://idm.timesmart.io/realms/timesmart-master
OAUTH2_APOLLO_DEMO_ISSUER=https://idm.timesmart.io/realms/apollo-demo
OAUTH2_TEST_ISSUER=https://idm.timesmart.io/realms/test
OAUTH2_HOPKINS_ISSUER=https://idm.timesmart.io/realms/hopkins
OAUTH2_CARDINALHEALTH_ISSUER=https://idm.timesmart.io/realms/cardinalhealth
OAUTH2_MCH_ISSUER=https://idm.timesmart.io/realms/mch
OAUTH2_SMMC_TRIAL_ISSUER=https://idm.timesmart.io/realms/smmc-trial
OAUTH2_PCC_TRIAL_ISSUER=https://idm.timesmart.io/realms/pcc-trial
OAUTH2_ZUKERBERGHOSPITAL_ISSUER=https://idm.timesmart.io/realms/zukerberghospital
OAUTH2_ORTHOPEDICSABBI_ISSUER=https://idm.timesmart.io/realms/orthopedicsabbi
OAUTH2_SMMC_IO_PROD_ISSUER=https://idm.timesmart.io/realms/smmc-io-prod
OAUTH2_TENET_IO_PROD_ISSUER=https://idm.timesmart.io/realms/tenet-io-prod

