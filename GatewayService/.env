# ====================================================================
# Microservice URLs (Load Balanced)
# For Docker development, use host.docker.internal to reach host machine
# For server deployment, change to localhost
# ====================================================================
SERVICE_USER_MANAGEMENT_HOST=host.docker.internal
SERVICE_USER_MANAGEMENT_PORT=8001
SERVICE_USER_MANAGEMENT_URL=http://host.docker.internal:8001

SERVICE_CONTRACT_MANAGEMENT_HOST=host.docker.internal
SERVICE_CONTRACT_MANAGEMENT_PORT=8002
SERVICE_CONTRACT_MANAGEMENT_URL=http://host.docker.internal:8002

SERVICE_ENTITY_HOST=host.docker.internal
SERVICE_ENTITY_PORT=8003
SERVICE_ENTITY_URL=http://host.docker.internal:8003

SERVICE_TIMESHEET_MANAGEMENT_HOST=host.docker.internal
SERVICE_TIMESHEET_MANAGEMENT_PORT=8004
SERVICE_TIMESHEET_MANAGEMENT_URL=http://host.docker.internal:8004

SERVICE_NOTIFICATION_HOST=host.docker.internal
SERVICE_NOTIFICATION_PORT=8005
SERVICE_NOTIFICATION_URL=http://host.docker.internal:8005

SERVICE_DATA_MANAGER_HOST=host.docker.internal
SERVICE_DATA_MANAGER_PORT=8006
SERVICE_DATA_MANAGER_URL=http://host.docker.internal:8006

SERVICE_FEEDBACK_MANAGEMENT_HOST=host.docker.internal
SERVICE_FEEDBACK_MANAGEMENT_PORT=8007
SERVICE_FEEDBACK_MANAGEMENT_URL=http://host.docker.internal:8007

SERVICE_REPORT_HOST=host.docker.internal
SERVICE_REPORT_PORT=8008
SERVICE_REPORT_URL=http://host.docker.internal:8008

# ====================================================================
# Security & CORS
# ====================================================================
CSRF_COOKIE_ACCESSIBLE_FROM_JS=true
LOGIN_PATH=/
POST_LOGIN_REDIRECT_PATH=/home/
POST_LOGOUT_REDIRECT_PATH=/home
BACK_CHANNEL_LOGOUT_ENABLED=true

# Permit-All Paths (comma-separated)
PERMIT_ALL_PATHS=/login/**,/oauth2/**,/,/login-options,/me,/ui/**,/app/**,/v3/api-docs/**,/user-management-service/user/ssoid/**,/entity-service/entityID,/entity-service/entity/logo,/entity-service/entity/allEntity

# ====================================================================
# Gateway Filters & Routes
# ====================================================================
GATEWAY_DEFAULT_FILTERS=TokenRelay=,DedupeResponseHeader=Access-Control-Allow-Credentials Access-Control-Allow-Origin,SaveSession
GATEWAY_DISCOVERY_ENABLED=true
GATEWAY_LOWER_CASE_SERVICE_ID=true

# ====================================================================
# Timeouts & Lifecycle
# ====================================================================
SHUTDOWN_TIMEOUT_SECONDS=30
CONNECTION_TIMEOUT_SECONDS=30
REQUEST_TIMEOUT_SECONDS=60

# ====================================================================
# Health Checks (Kubernetes)
# ====================================================================
HEALTH_ENDPOINT_ENABLED=true
HEALTH_LIVENESS_ENABLED=true
HEALTH_READINESS_ENABLED=true
HEALTH_CHECK_INTERVAL_SECONDS=30
HEALTH_CHECK_TIMEOUT_SECONDS=10
HEALTH_CHECK_RETRIES=3

# ====================================================================
# Logging Configuration
# ====================================================================
LOG_LEVEL_ROOT=ERROR
LOG_LEVEL_SECURITY=DEBUG
LOG_FORMAT=json

# ====================================================================
# Microservices Configuration
# ====================================================================
# List of known microservices for direct routing
KNOWN_SERVICES=user-management-service,contract-management-service,entity-service,timesheet-management-service,notification-service,data-manager-service,feedback-management-service,report-service

# ====================================================================
# Feature Flags
# ====================================================================
FEATURE_EUREKA_DISCOVERY=true
FEATURE_TOKEN_RELAY=true
FEATURE_REQUEST_LOGGING=true
FEATURE_CORS_HEADERS=true
FEATURE_SESSION_MANAGEMENT=true

# ====================================================================
# Load Balancing
# ====================================================================
LOADBALANCER_RIBBON_ENABLED=false
