# ====================================================================
# Gateway Service Environment Configuration - QA
# ====================================================================

# Application Settings
APP_PROFILE=qa
DEBUG=false
LOG_LEVEL=INFO

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_SSL_ENABLED=false
SCHEME=https
KEYCLOAK_PORT=443

# Gateway URIs
GATEWAY_BASE_URI=https://localhost:8000
GREETINGS_API_URI=https://localhost:6443/greetings
REACT_APP_URI=https://app.timesmart.io
FLUTTER_APP_URI=https://app.timesmart.io

# Master Entity
MASTER_ENTITY_NAME=timesmart-master

# Eureka Discovery Service
# For Docker: use eureka-service (internal container name)
# For server: change to localhost:8761
EUREKA_ENABLED=true
EUREKA_URL=http://host.docker.internal:8761/eureka/
EUREKA_FETCH_REGISTRY=true
EUREKA_REGISTER_WITH_EUREKA=true
EUREKA_PREFER_IP_ADDRESS=true

# ====================================================================
# Keycloak Configuration
# ====================================================================
KEYCLOAK_SERVER_URL=https://idm.timesmart.io
KEYCLOAK_REALMS=timesmart-master,zukerberghospital,hopkins,orthopedicsabbi,smmc-io-prod,tenet-io-prod

# Keycloak Issuers (comma-separated)
KEYCLOAK_ISSUERS=https://idm.timesmart.io/realms/timesmart-master,https://idm.timesmart.io/realms/zukerberghospital,https://idm.timesmart.io/realms/hopkins,https://idm.timesmart.io/realms/orthopedicsabbi,https://idm.timesmart.io/realms/smmc-io-prod,https://idm.timesmart.io/realms/tenet-io-prod

# ====================================================================
# OAuth2 Client Registrations
# ====================================================================

# timesmart-master Realm
OAUTH2_TIMESMART_MASTER_CLIENT_ID=spring-addons-confidential
OAUTH2_TIMESMART_MASTER_CLIENT_SECRET=aQe4uXvyaIF5AMHlXNhmh38Fox3L396H
OAUTH2_TIMESMART_MASTER_ISSUER=https://idm.timesmart.io/realms/timesmart-master
OAUTH2_TIMESMART_MASTER_REDIRECT_URI=https://timesmart.io/login/oauth2/code/timesmart-master
OAUTH2_TIMESMART_MASTER_SCOPE=openid,profile,email,offline_access,roles

